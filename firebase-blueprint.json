{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User account information including their system role (administrador or tecnico).",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": [ "administrador", "tecnico" ] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [ "uid", "email", "name", "role", "createdAt" ]
    },
    "Component": {
      "title": "Autopilot Component",
      "description": "An autopilot component (e.g. antenna, monitor, controller) manufactured by Trimble or Topcon.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "serialNumber": { "type": "string" },
        "name": { "type": "string" },
        "brand": { "type": "string", "enum": [ "Trimble", "Topcon" ] },
        "type": { "type": "string" },
        "status": { "type": "string", "enum": [ "Disponível", "Em Uso", "Manutenção", "Descartado" ] },
        "currentMachine": { "type": "string", "description": "LEGACY – Machine prefix (kept for backward compat)." },
        "currentLocationId": { "type": "string", "description": "FK -> Location.id (canonical)." },
        "currentMachineId": { "type": "string", "description": "FK -> Machine.id (canonical)." },
        "updatedAt": { "type": "string", "format": "date-time" },
        "updatedBy": { "type": "string" },
        "placementVersion": { "type": "integer", "enum": [ 1 ], "description": "Destination verified by explicit storage workflow; exactly one location or machine." }
      },
      "required": [ "id", "serialNumber", "name", "brand", "type", "status", "updatedAt", "updatedBy" ]
    },
    "Machine": {
      "title": "Agricultural Machine",
      "description": "A tractor, harvester, or sprayer that can be fitted with autopilot components.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "prefix": { "type": "string" },
        "type": { "type": "string", "enum": [ "Trator", "Colhedora", "Pulverizador", "Outro" ] },
        "model": { "type": "string" },
        "brand": { "type": "string" },
        "fleet": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [ "id", "prefix", "type", "model", "brand", "updatedAt" ]
    },
    "Movement": {
      "title": "Component Movement Log",
      "description": "An auditable order of service for component installation, removal, maintenance, or calibration.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "componentId": { "type": "string" },
        "componentSerial": { "type": "string" },
        "componentName": { "type": "string" },
        "machineId": { "type": "string" },
        "machinePrefix": { "type": "string" },
        "action": { "type": "string", "enum": [ "Instalação", "Remoção", "Manutenção", "Calibração" ] },
        "technicianId": { "type": "string" },
        "technicianName": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "osNumber": { "type": "number" },
        "status": { "type": "string", "enum": [ "Aberta", "Agendada", "Em Atendimento", "Concluída", "Cancelada" ] },
        "history": { "type": "array", "description": "Append-only lifecycle and edit audit events." },
        "completedAt": { "type": "string", "format": "date-time" },
        "cancelledAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "updatedBy": { "type": "string" },
        "locationId": { "type": "string", "description": "FK -> Location.id (canonical)." },
        "componentIds": { "type": "array", "description": "Multi-component support (PR5)." },
        "primaryComponentId": { "type": "string", "description": "Compat: copy of componentId for multi-component OS." }
      },
      "required": [ "id", "componentId", "componentSerial", "componentName", "machinePrefix", "action", "technicianId", "technicianName", "date", "createdAt" ]
    },
    "FieldDataCollection": {
      "title": "Field Data Collection (Semanal)",
      "description": "Weekly record of field data collection status per machine, used by the Recolhimento de Dados de Campo Kanban.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Stable weekly key, e.g. 2026-W32_mac1" },
        "machineId": { "type": "string" },
        "machinePrefix": { "type": "string" },
        "machineBrand": { "type": "string" },
        "machineModel": { "type": "string" },
        "machineType": { "type": "string", "enum": [ "Trator", "Colhedora", "Pulverizador", "Outro" ] },
        "fleet": { "type": "string" },
        "frente": { "type": "string" },
        "weekId": { "type": "string", "description": "ISO week id, e.g. 2026-W32" },
        "status": { "type": "string", "enum": [ "Pendente", "Concluído" ] },
        "collectedAt": { "type": "string", "format": "date-time" },
        "collectedBy": { "type": "string" },
        "history": { "type": "array", "description": "Append-only weekly status events." },
        "createdAt": { "type": "string", "format": "date-time" },
        "notes": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [ "id", "machineId", "machinePrefix", "weekId", "status", "updatedAt" ]
    },
    "ThirdParty": {
      "title": "Third-Party Provider",
      "description": "Information about third-party providers or contractors who can loan GPS hardware components.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "document": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "company": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "updatedBy": { "type": "string" }
      },
      "required": [ "id", "name", "document", "phone", "email", "company", "createdAt", "updatedAt", "updatedBy" ]
    },
    "ComponentLoan": {
      "title": "Component Loan",
      "description": "A record of equipment loans to third-party providers, including comodato terms.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "thirdPartyId": { "type": "string" },
        "thirdPartyName": { "type": "string" },
        "thirdPartyDocument": { "type": "string" },
        "thirdPartyCompany": { "type": "string" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "componentId": { "type": "string" },
              "componentSerial": { "type": "string" },
              "componentName": { "type": "string" },
              "componentBrand": { "type": "string" },
              "componentType": { "type": "string" }
            },
            "required": [ "componentId", "componentSerial", "componentName", "componentBrand", "componentType" ]
          }
        },
        "loanDate": { "type": "string", "format": "date" },
        "estimatedReturnDate": { "type": "string", "format": "date" },
        "actualReturnDate": { "type": "string", "format": "date" },
        "status": { "type": "string", "enum": [ "Ativo", "Devolvido" ] },
        "contractNumber": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "updatedBy": { "type": "string" },
        "locationId": { "type": "string" },
        "returnLocationId": { "type": "string" }
      },
      "required": [ "id", "thirdPartyId", "thirdPartyName", "thirdPartyDocument", "thirdPartyCompany", "items", "loanDate", "status", "contractNumber", "createdAt", "updatedAt", "updatedBy" ]
    },
    "CompanyProfileSettings": {
      "title": "Company Profile Settings",
      "description": "Registration settings for the licensed business utilizing the platform.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "tradingName": { "type": "string" },
        "cnpj": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "address": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "updatedBy": { "type": "string" }
      },
      "required": [ "name", "cnpj", "updatedAt", "updatedBy" ]
    },
    "RegisteredType": {
      "title": "Registered Type",
      "description": "Dynamically managed type registry (collection: type_registry) used by Settings > Cadastro for partner, equipment and service types.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "category": { "type": "string", "enum": [ "partner", "vehicle", "equipment_component", "service" ] },
        "name": { "type": "string" },
        "active": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "updatedBy": { "type": "string" }
      },
      "required": [ "id", "category", "name", "active", "updatedAt", "updatedBy" ]
    },
    "LicenseAlertSettings": {
      "title": "License Alert Settings",
      "description": "Email alert settings for license expirations (doc: settings/licenses).",
      "type": "object",
      "properties": {
        "alertEmails": {
          "type": "array",
          "items": { "type": "string" }
        },
        "alertEmail": { "type": "string", "description": "Legacy field (migrated to alertEmails)." },
        "enabled": { "type": "boolean" },
        "thresholds": {
          "type": "object",
          "properties": {
            "15": { "type": "boolean" },
            "30": { "type": "boolean" },
            "60": { "type": "boolean" }
          }
        },
        "notifyExpired": { "type": "boolean" },
        "lastSentExpired": { "type": "string" },
        "lastSent60": { "type": "string" },
        "lastSent30": { "type": "string" },
        "lastSent15": { "type": "string" },
        "history": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": { "type": "string" },
              "date": { "type": "string", "format": "date-time" },
              "recipient": { "type": "string" },
              "status": { "type": "string", "enum": [ "Enviado", "Falhou" ] }
            }
          }
        },
        "updatedAt": { "type": "string", "format": "date-time" },
        "updatedBy": { "type": "string" }
      },
      "required": [ "alertEmails", "enabled", "thresholds", "notifyExpired", "updatedAt", "updatedBy" ]
    },
    "CampoAlertSettings": {
      "title": "Field Data Alert Settings",
      "description": "Weekly field data pending-fronts alert settings (doc: settings/campo_alerts).",
      "type": "object",
      "properties": {
        "alertEmails": {
          "type": "array",
          "items": { "type": "string" }
        },
        "alertEmail": { "type": "string", "description": "Legacy field (migrated to alertEmails)." },
        "enabled": { "type": "boolean" },
        "scheduleDay": { "type": "string" },
        "scheduleTime": { "type": "string" },
        "lastSentWeek": { "type": "string" },
        "history": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": { "type": "string" },
              "date": { "type": "string", "format": "date-time" },
              "recipient": { "type": "string" },
              "status": { "type": "string", "enum": [ "Enviado", "Falhou" ] }
            }
          }
        },
        "updatedAt": { "type": "string", "format": "date-time" },
        "updatedBy": { "type": "string" }
      },
      "required": [ "alertEmails", "enabled", "scheduleDay", "scheduleTime", "updatedAt", "updatedBy" ]
    },
    "LoanAlertSettings": {
      "title": "Loan Alert Settings",
      "description": "Overdue loan alert settings (doc: settings/loan_alerts).",
      "type": "object",
      "properties": {
        "alertEmails": {
          "type": "array",
          "items": { "type": "string" }
        },
        "alertEmail": { "type": "string", "description": "Legacy field (migrated to alertEmails)." },
        "enabled": { "type": "boolean" },
        "lastSentDate": { "type": "string" },
        "history": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": { "type": "string" },
              "date": { "type": "string", "format": "date-time" },
              "recipient": { "type": "string" },
              "status": { "type": "string", "enum": [ "Enviado", "Falhou" ] }
            }
          }
        },
        "updatedAt": { "type": "string", "format": "date-time" },
        "updatedBy": { "type": "string" }
      },
      "required": [ "alertEmails", "enabled", "updatedAt", "updatedBy" ]
    },
    "MaintenanceAlertSettings": {
      "title": "Maintenance Alert Settings",
      "description": "Overdue/completed maintenance alert settings (doc: settings/maintenance_alerts).",
      "type": "object",
      "properties": {
        "alertEmails": {
          "type": "array",
          "items": { "type": "string" }
        },
        "enabled": { "type": "boolean" },
        "overdueDays": { "type": "number" },
        "notifyCompleted": { "type": "boolean" },
        "lastSentDate": { "type": "string" },
        "notifiedIds": {
          "type": "array",
          "items": { "type": "string" }
        },
        "history": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": { "type": "string" },
              "date": { "type": "string", "format": "date-time" },
              "recipient": { "type": "string" },
              "status": { "type": "string", "enum": [ "Enviado", "Falhou" ] }
            }
          }
        },
        "updatedAt": { "type": "string", "format": "date-time" },
        "updatedBy": { "type": "string" }
      },
      "required": [ "alertEmails", "enabled", "overdueDays", "notifyCompleted", "updatedAt", "updatedBy" ]
    },
    "IdleAlertSettings": {
      "title": "Idle Components Alert Settings",
      "description": "Idle (available, no movement) components alert settings (doc: settings/idle_alerts).",
      "type": "object",
      "properties": {
        "alertEmails": {
          "type": "array",
          "items": { "type": "string" }
        },
        "enabled": { "type": "boolean" },
        "idleDays": { "type": "number" },
        "lastSentDate": { "type": "string" },
        "history": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": { "type": "string" },
              "date": { "type": "string", "format": "date-time" },
              "recipient": { "type": "string" },
              "status": { "type": "string", "enum": [ "Enviado", "Falhou" ] }
            }
          }
        },
        "updatedAt": { "type": "string", "format": "date-time" },
        "updatedBy": { "type": "string" }
      },
      "required": [ "alertEmails", "enabled", "idleDays", "updatedAt", "updatedBy" ]
    },
    "Location": {
      "title": "Location",
      "description": "A physical or external destination where components are stored, serviced (assistência técnica), or loaned (comodato).",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "kind": { "type": "string", "enum": [ "INTERNAL", "EXTERNAL_SERVICE", "EXTERNAL_LOAN" ] },
        "partnerId": { "type": "string", "description": "FK -> Partner.id (optional, for external locations)." },
        "address": { "type": "string" },
        "contactPerson": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "isActive": { "type": "boolean" },
        "notes": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "updatedBy": { "type": "string" },
        "code": { "type": "string", "maxLength": 40 }
      },
      "required": [ "id", "name", "kind", "isActive", "updatedAt", "updatedBy" ]
    },
    "StorageSettings": {
      "type": "object",
      "properties": {
        "defaultLocationId": { "type": "string" },
        "revision": { "type": "integer" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "updatedBy": { "type": "string" }
      },
      "required": [ "defaultLocationId", "revision", "updatedAt", "updatedBy" ]
    },
    "LocationEvent": {
      "type": "object",
      "description": "Immutable destination change. Historical names are snapshots; canonical IDs remain authoritative.",
      "properties": {
        "id": { "type": "string" },
        "operationId": { "type": "string" },
        "componentId": { "type": "string" },
        "componentName": { "type": "string" },
        "componentSerial": { "type": "string" },
        "from": {
          "type": "object",
          "properties": {
            "locationId": { "type": "string" },
            "machineId": { "type": "string" },
            "label": { "type": "string" }
          }
        },
        "to": {
          "type": "object",
          "properties": {
            "locationId": { "type": "string" },
            "machineId": { "type": "string" },
            "label": { "type": "string" }
          }
        },
        "action": { "type": "string" },
        "referenceId": { "type": "string" },
        "notes": { "type": "string" },
        "actorId": { "type": "string" },
        "actorName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Profiles and role classifications of staff members."
    },
    "/components/{componentId}": {
      "schema": { "$ref": "#/entities/Component" },
      "description": "Inventory of Trimble and Topcon agricultural GPS autopilot hardware components."
    },
    "/machines/{machineId}": {
      "schema": { "$ref": "#/entities/Machine" },
      "description": "Agricultural vehicle fleet database."
    },
    "/movements/{movementId}": {
      "schema": { "$ref": "#/entities/Movement" },
      "description": "Activity history tracking modifications, relocations, installations, and maintenance services."
    },
    "/third_parties/{thirdPartyId}": {
      "schema": { "$ref": "#/entities/ThirdParty" },
      "description": "Third-party operators and service providers."
    },
    "/loans/{loanId}": {
      "schema": { "$ref": "#/entities/ComponentLoan" },
      "description": "Records of components loaned out to third parties under Comodato contracts."
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/CompanyProfileSettings" },
      "description": "System configuration parameters and company profiles. Also stores settings/licenses (LicenseAlertSettings), settings/campo_alerts (CampoAlertSettings), settings/loan_alerts (LoanAlertSettings), settings/maintenance_alerts (MaintenanceAlertSettings) and settings/idle_alerts (IdleAlertSettings)."
    },
    "/locations/{locationId}": {
      "schema": { "$ref": "#/entities/Location" },
      "description": "Storage locations, external service destinations (assistência técnica) and loan destinations (comodato)."
    },
    "/counters/{counterId}": {
      "schema": {
        "type": "object",
        "properties": {
          "value": { "type": "integer", "description": "Last OS number emitted (atomic counter)." },
          "updatedAt": { "type": "string", "format": "date-time" }
        },
        "required": [ "value" ]
      },
      "description": "Atomic counters for sequential numbering (doc: counters/osNumber)."
    },
    "/storage_settings/main": {
      "schema": { "$ref": "#/entities/StorageSettings" },
      "description": "Explicit suggested warehouse and serialization revision for atomic storage commands."
    },
    "/location_events/{eventId}": {
      "schema": { "$ref": "#/entities/LocationEvent" },
      "description": "Immutable placement history, linked by component and operation."
    },
    "/storage_operations/{operationId}": {
      "schema": {
        "type": "object",
        "properties": {
          "actorId": { "type": "string" },
          "type": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "description": "Immutable idempotency receipts, written atomically with the operation."
    }
  }
}
