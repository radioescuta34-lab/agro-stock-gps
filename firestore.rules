rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Catch-all default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      return isSignedIn() && (
        getUserData().role == 'administrador' ||
        getUserData().role == 'ADMINISTRADOR' ||
        request.auth.token.email == 'endriuse@hotmail.com' ||
        request.auth.token.email == 'endriusernane@gmail.com'
      );
    }
    
    function isTechnician() {
      return isSignedIn() && (
        getUserData().role == 'tecnico' ||
        getUserData().role == 'TECNICO_CAMPO'
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Soft-delete: admin-only update that inactivates a record instead of deleting it.
    // bKey is an extra allowed key (e.g. 'updatedBy' for components); pass '' when unused.
    function isSoftDeleteUpdate(bKey) {
      let allowed = ['active', 'deletedAt', 'updatedAt']
        .concat(bKey != '' ? [bKey] : []);
      return isAdmin()
        && request.resource.data.active == false
        && request.resource.data.deletedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
    }

    // Validate User Profile
    function isValidUser(user) {
      return user.uid is string && user.uid.size() <= 128
        && user.email is string && user.email.size() <= 128
        && user.name is string && user.name.size() <= 128
        && (user.role == 'administrador' || user.role == 'tecnico' || user.role == 'ADMINISTRADOR' || user.role == 'TECNICO_CAMPO');
    }

    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isAdmin(); // Only admins can list users
      allow create: if isSignedIn() && (request.auth.uid == userId || isAdmin()) && isValidUser(request.resource.data);
      allow update: if isSignedIn() && (
        (request.auth.uid == userId && request.resource.data.role == resource.data.role) || 
        isAdmin()
      ) && isValidUser(request.resource.data);
      allow delete: if isAdmin();
    }

    // Validate Component
    function isValidComponent(comp) {
      return comp.id is string && comp.id.size() <= 128
        && comp.serialNumber is string && comp.serialNumber.size() <= 128
        && comp.name is string && comp.name.size() <= 128
        && (comp.brand == 'Trimble' || comp.brand == 'Topcon')
        && comp.type is string && comp.type.size() <= 128
        && (comp.status == 'Disponível' || comp.status == 'Em Uso' || comp.status == 'Manutenção' || comp.status == 'Descartado')
        && (!('currentLocationId' in comp) || (comp.currentLocationId is string && comp.currentLocationId.size() <= 128))
        && (!('currentMachineId' in comp) || (comp.currentMachineId is string && comp.currentMachineId.size() <= 128))
        && (!('placementVersion' in comp) || (comp.placementVersion == 1
          && !((comp.get('currentLocationId', '') != '') && (comp.get('currentMachineId', '') != ''))
          && (comp.get('currentLocationId', '') != '' || comp.get('currentMachineId', '') != '')));
    }

    match /components/{componentId} {
      allow get, list: if isSignedIn();
      allow create: if isAdmin() && isValidId(componentId) && isValidComponent(request.resource.data) && request.resource.data.updatedAt == request.time;
      allow delete: if false; // soft-delete only (active/deletedAt)
      allow update: if isSignedIn() && isValidId(componentId) && request.resource.data.updatedAt == request.time && (
        isSoftDeleteUpdate('updatedBy')
        || (
          isValidComponent(request.resource.data) && (
            isAdmin() || (
              // Technician can only update component status, location/machine, updatedAt, and updatedBy
              request.resource.data.serialNumber == resource.data.serialNumber
              && request.resource.data.brand == resource.data.brand
              && request.resource.data.name == resource.data.name
              && request.resource.data.type == resource.data.type
              && isTechnician()
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'currentMachine', 'currentLocationId', 'currentMachineId', 'placementVersion', 'updatedAt', 'updatedBy'])
            )
          )
        )
      );
    }

    // Validate Machine
    function isValidMachine(mac) {
      return mac.id is string && mac.id.size() <= 128
        && mac.prefix is string && mac.prefix.size() <= 128
        && mac.type is string && mac.type.size() <= 64
        && mac.model is string && mac.model.size() <= 128
        && mac.brand is string && mac.brand.size() <= 128
        && (!('fleet' in mac) || (mac.fleet is string && mac.fleet.size() <= 128));
    }

    match /machines/{machineId} {
      allow get, list: if isSignedIn();
      allow create: if (isAdmin() || isTechnician()) && isValidId(machineId) && isValidMachine(request.resource.data);
      allow update: if (isAdmin() || isTechnician()) && isValidId(machineId) && (
        isSoftDeleteUpdate('')
        || isValidMachine(request.resource.data)
      );
      allow delete: if false; // soft-delete only (active/deletedAt)
    }

    // Validate License
    function isValidLicense(lic) {
      return lic.id is string && lic.id.size() <= 128
        && lic.name is string && lic.name.size() <= 128
        && (lic.brand == 'Trimble' || lic.brand == 'Topcon')
        && (lic.type == 'Assinatura de Sinal' || lic.type == 'Ativação de Tela')
        && lic.code is string && lic.code.size() <= 256;
    }

    match /licenses/{licenseId} {
      allow get, list: if isSignedIn();
      allow create, update: if (isAdmin() || isTechnician()) && isValidId(licenseId) && isValidLicense(request.resource.data);
      allow delete: if (isAdmin() || isTechnician());
    }

    // Validate Movement (Order of Service)
    function isValidMovement(move) {
      return move.id is string && move.id.size() <= 128
        && move.componentId is string && move.componentId.size() <= 128
        && move.componentSerial is string && move.componentSerial.size() <= 128
        && move.componentName is string && move.componentName.size() <= 128
        && (!('machineId' in move) || (move.machineId is string && move.machineId.size() <= 128))
        && move.machinePrefix is string && move.machinePrefix.size() <= 128
        && move.action is string && move.action.size() <= 64
        && move.technicianId is string && move.technicianId.size() <= 128
        && move.technicianName is string && move.technicianName.size() <= 128
        && (!('osNumber' in move) || move.osNumber is number)
        && (!('status' in move) || (move.status == 'Aberta' || move.status == 'Agendada' || move.status == 'Em Atendimento' || move.status == 'Concluída' || move.status == 'Cancelada'))
        && (!('history' in move) || move.history is list)
        && (!('completedAt' in move) || move.completedAt is string || move.completedAt is timestamp)
        && (!('cancelledAt' in move) || move.cancelledAt is string || move.cancelledAt is timestamp)
        && (!('updatedAt' in move) || move.updatedAt == request.time)
        && (!('updatedBy' in move) || (move.updatedBy is string && move.updatedBy.size() <= 128))
        && (!('locationId' in move) || (move.locationId is string && move.locationId.size() <= 128))
        && (!('componentIds' in move) || (move.componentIds is list && move.componentIds.size() <= 50))
        && (!('primaryComponentId' in move) || (move.primaryComponentId is string && move.primaryComponentId.size() <= 128));
    }

    function isValidStatusTransition(previousStatus, nextStatus) {
      return (previousStatus == 'Aberta' && (nextStatus == 'Agendada' || nextStatus == 'Em Atendimento' || nextStatus == 'Cancelada'))
        || (previousStatus == 'Agendada' && (nextStatus == 'Aberta' || nextStatus == 'Em Atendimento' || nextStatus == 'Cancelada'))
        || (previousStatus == 'Em Atendimento' && (nextStatus == 'Agendada' || nextStatus == 'Concluída' || nextStatus == 'Cancelada'));
    }

    // Allows audited lifecycle transitions and corrections before execution begins.
    function isValidMovementUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let validHistoryAppend = request.resource.data.history is list
        && (!('history' in resource.data) || request.resource.data.history.size() == resource.data.history.size() + 1);
      let lifecycleUpdate = changed.hasOnly(['status', 'history', 'completedAt', 'cancelledAt', 'updatedAt', 'updatedBy', 'locationId'])
        && (!changed.hasAny(['locationId']) || (resource.data.action == 'Remoção' && request.resource.data.status == 'Concluída'))
        && isValidStatusTransition(('status' in resource.data) ? resource.data.status : 'Aberta', request.resource.data.status);
      let editableUpdate = (!('status' in resource.data) || resource.data.status == 'Aberta' || resource.data.status == 'Agendada')
        && request.resource.data.status == (('status' in resource.data) ? resource.data.status : 'Aberta')
        && changed.hasOnly(['componentId', 'componentSerial', 'componentName', 'machineId', 'machinePrefix', 'action', 'date', 'notes', 'status', 'history', 'updatedAt', 'updatedBy', 'locationId', 'componentIds', 'primaryComponentId']);
      return isValidMovement(request.resource.data)
        && validHistoryAppend
        && (lifecycleUpdate || editableUpdate);
    }

    match /movements/{movementId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(movementId) && isValidMovement(request.resource.data) && request.resource.data.createdAt == request.time;
      allow update: if (isAdmin() || isTechnician()) && isValidMovementUpdate();
      // Only orders that have not started may be physically deleted. Executed orders remain auditable.
      allow delete: if isAdmin() && (!('status' in resource.data) || resource.data.status == 'Aberta' || resource.data.status == 'Agendada');
    }

    // Validate FieldDataCollection (weekly field data collection kanban)
    function isValidFieldDataCollection(fdc) {
      return fdc.id is string && fdc.id.size() <= 128
        && fdc.machineId is string && fdc.machineId.size() <= 128
        && fdc.machinePrefix is string && fdc.machinePrefix.size() <= 128
        && (!('machineBrand' in fdc) || (fdc.machineBrand is string && fdc.machineBrand.size() <= 128))
        && (!('machineModel' in fdc) || (fdc.machineModel is string && fdc.machineModel.size() <= 128))
        && (!('machineType' in fdc) || (fdc.machineType is string && fdc.machineType.size() <= 64))
        && fdc.weekId is string && fdc.weekId.matches('^[0-9]{4}-W[0-9]{2}$')
        && (fdc.status == 'Pendente' || fdc.status == 'Concluído')
        && (!('collectedAt' in fdc) || fdc.collectedAt is string)
        && (!('collectedBy' in fdc) || (fdc.collectedBy is string && fdc.collectedBy.size() <= 128))
        && (!('history' in fdc) || fdc.history is list)
        && (!('frente' in fdc) || (fdc.frente is string && fdc.frente.size() <= 128));
    }

    match /field_data_collections/{fdcId} {
      allow get, list: if isSignedIn();
      allow create, update: if (isAdmin() || isTechnician()) && isValidId(fdcId) && isValidFieldDataCollection(request.resource.data);
      allow delete: if false;
    }

    // Validate ThirdParty
    function isValidThirdParty(tp) {
      return tp.id is string && tp.id.size() <= 128
        && tp.name is string && tp.name.size() <= 128
        && tp.document is string && tp.document.size() <= 64
        && tp.phone is string && tp.phone.size() <= 64
        && tp.email is string && tp.email.size() <= 128
        && tp.company is string && tp.company.size() <= 128;
    }

    match /third_parties/{thirdPartyId} {
      allow get, list: if isSignedIn();
      allow create, update: if (isAdmin() || isTechnician()) && isValidId(thirdPartyId) && isValidThirdParty(request.resource.data);
      allow delete: if isAdmin();
    }

    // Validate ComponentLoan
    function isValidLoan(loan) {
      return loan.id is string && loan.id.size() <= 128
        && loan.thirdPartyId is string && loan.thirdPartyId.size() <= 128
        && loan.thirdPartyName is string && loan.thirdPartyName.size() <= 128
        && loan.thirdPartyDocument is string && loan.thirdPartyDocument.size() <= 64
        && loan.thirdPartyCompany is string && loan.thirdPartyCompany.size() <= 128
        && loan.items is list
        && (loan.status == 'Ativo' || loan.status == 'Devolvido')
        && loan.contractNumber is string && loan.contractNumber.size() <= 64;
    }

    match /loans/{loanId} {
      allow get, list: if isSignedIn();
      allow create, update: if (isAdmin() || isTechnician()) && isValidId(loanId) && isValidLoan(request.resource.data);
      allow delete: if isAdmin();
    }

    // Validate ComponentMaintenance
    function isValidMaintenance(maint) {
      return maint.id is string && maint.id.size() <= 128
        && maint.componentId is string && maint.componentId.size() <= 128
        && maint.componentSerial is string && maint.componentSerial.size() <= 128
        && maint.componentName is string && maint.componentName.size() <= 128
        && maint.providerName is string && maint.providerName.size() <= 256
        && maint.status is string && (maint.status == 'Em Manutenção' || maint.status == 'Concluído' || maint.status == 'Sem Conserto');
    }

    match /maintenances/{maintenanceId} {
      allow get, list: if isSignedIn();
      allow create, update: if (isAdmin() || isTechnician()) && isValidId(maintenanceId) && isValidMaintenance(request.resource.data);
      allow delete: if isAdmin();
    }

    // Validate MaintenanceProvider
    function isValidProvider(prov) {
      return prov.id is string && prov.id.size() <= 128
        && prov.name is string && prov.name.size() <= 128;
    }

    match /providers/{providerId} {
      allow get, list: if isSignedIn();
      allow create, update: if (isAdmin() || isTechnician()) && isValidId(providerId) && isValidProvider(request.resource.data);
      allow delete: if isAdmin();
    }

    function isValidPartner(partner) {
      return partner.id is string && partner.id.size() <= 128
        && partner.legalName is string && partner.legalName.size() <= 256
        && partner.document is string && partner.document.size() <= 64
        && partner.phone is string && partner.phone.size() <= 64
        && partner.email is string && partner.email.size() <= 128
        && partner.types is list
        && partner.types.size() > 0
        && partner.active is bool;
    }

    match /partners/{partnerId} {
      allow get, list: if isSignedIn();
      allow create, update: if (isAdmin() || isTechnician()) && isValidId(partnerId) && isValidPartner(request.resource.data);
      allow delete: if false;
    }

    // Validate Location (storage / external service / external loan destination)
    function isValidLocation(loc) {
      let activeOk = (('isActive' in loc) && loc.isActive is bool) || (('active' in loc) && loc.active is bool);
      return loc.id is string && loc.id.size() <= 128
        && loc.name is string && loc.name.size() <= 256
        && (loc.kind == 'INTERNAL' || loc.kind == 'EXTERNAL_SERVICE' || loc.kind == 'EXTERNAL_LOAN')
        && activeOk
        && (!('partnerId' in loc) || (loc.partnerId is string && loc.partnerId.size() <= 128))
        && (!('address' in loc) || (loc.address is string && loc.address.size() <= 512))
        && (!('contactPerson' in loc) || (loc.contactPerson is string && loc.contactPerson.size() <= 128))
        && (!('phone' in loc) || (loc.phone is string && loc.phone.size() <= 64))
        && (!('email' in loc) || (loc.email is string && loc.email.size() <= 128))
        && (!('notes' in loc) || (loc.notes is string && loc.notes.size() <= 512));
    }

    match /locations/{locationId} {
      allow get, list: if isSignedIn();
      allow create, update: if isValidId(locationId) && isValidLocation(request.resource.data)
        && request.resource.data.updatedAt == request.time
        && (!('code' in request.resource.data) || (request.resource.data.code is string && request.resource.data.code.size() <= 40))
        && (!exists(/databases/$(database)/documents/locations/$(locationId)) || resource.data.kind == request.resource.data.kind)
        && (request.resource.data.isActive == true || !exists(/databases/$(database)/documents/storage_settings/main)
          || getAfter(/databases/$(database)/documents/storage_settings/main).data.defaultLocationId != locationId)
        && (isAdmin() || (isTechnician() && request.resource.data.kind != 'INTERNAL'
          && request.resource.data.partnerId is string
          && get(/databases/$(database)/documents/partners/$(request.resource.data.partnerId)).data.active == true
          && request.resource.data.isActive == true));
      allow delete: if false;
    }

    // Global revision protects multi-document destination operations from concurrent commands.
    function validStorageDefault() {
      let id = request.resource.data.defaultLocationId;
      return id is string && (id == '' || (getAfter(/databases/$(database)/documents/locations/$(id)).data.kind == 'INTERNAL'
        && getAfter(/databases/$(database)/documents/locations/$(id)).data.isActive == true));
    }
    match /storage_settings/{settingId} {
      allow read: if isSignedIn();
      allow create: if settingId == 'main' && (isAdmin() || isTechnician())
        && validStorageDefault() && request.resource.data.revision == 1 && request.resource.data.updatedAt == request.time
        && (isAdmin() || request.resource.data.defaultLocationId == '');
      allow update: if settingId == 'main' && (isAdmin() || isTechnician())
        && validStorageDefault() && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.updatedAt == request.time
        && (isAdmin() || request.resource.data.defaultLocationId == resource.data.defaultLocationId);
      allow delete: if false;
    }

    match /storage_operations/{operationId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create: if (isAdmin() || isTechnician()) && isValidId(operationId)
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /location_events/{eventId} {
      allow read: if isSignedIn();
      allow create: if (isAdmin() || isTechnician()) && eventId.size() <= 300
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.componentId is string
        && request.resource.data.from is map && request.resource.data.to is map
        && getAfter(/databases/$(database)/documents/storage_operations/$(request.resource.data.operationId)).data.actorId == request.auth.uid;
      allow update, delete: if false;
    }

    // Validate OS counter (atomic sequential numbering)
    function isValidOsCounter(c) {
      return c.value is int
        && c.value >= 0
        && (!('updatedAt' in c) || c.updatedAt == request.time);
    }

    match /counters/{counterId} {
      allow get, list: if isSignedIn();
      allow create, update: if (isAdmin() || isTechnician()) && isValidId(counterId) && counterId == 'osNumber' && isValidOsCounter(request.resource.data);
      allow delete: if false;
    }

    // Validate RegisteredType (Settings > Cadastro > Tipos)
    function isValidRegisteredType(t) {
      return t.id is string && t.id.size() <= 128
        && (t.category == 'partner' || t.category == 'vehicle' || t.category == 'equipment_component' || t.category == 'service')
        && t.name is string && t.name.size() <= 64
        && t.active is bool;
    }

    match /type_registry/{typeId} {
      allow get, list: if isSignedIn();
      allow create, update: if isAdmin() && isValidId(typeId) && isValidRegisteredType(request.resource.data) && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }
  }
}
