# AI_API_KEY: Required for AI API calls (OpenAI, DeepSeek, Gemini, or Claude).
# Set AI_PROVIDER to one of: openai, deepseek, gemini, claude (default: deepseek)
# AI_MODEL overrides the default model for the selected provider.
# Backward compat: DEEPSEEK_API_KEY still works (defaults to deepseek provider).
AI_API_KEY="MY_AI_API_KEY"
AI_PROVIDER="deepseek"
AI_MODEL=""

# Legacy: DEEPSEEK_API_KEY is used as fallback if AI_API_KEY is not set.
# DEEPSEEK_API_KEY="MY_DEEPSEEK_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# CONFIGURAÇÕES DE SMTP PARA ENVIO REAL DE EMAILS DE ALERTA DE LICENÇA
# Configure estas variáveis na aba Secrets/Settings do AI Studio para que os emails cheguem de verdade!
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="seu-usuario-smtp"
SMTP_PASS="sua-senha-ou-app-password"
SMTP_FROM_EMAIL="alerta@seudominio.com"
SMTP_FROM_NAME="Agro Stock GPS"

# FIREBASE_SERVICE_ACCOUNT_KEY (JSON string) — OBRIGATÓRIO para o Vercel Cron
# (GET /api/cron/alerts). Sem ele o cron responde 503. Gere uma service account
# no Firebase Console (Projeto > Configurações > Contas de serviço) e cole o JSON.
# Exemplo: FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account",...}'
# FIREBASE_SERVICE_ACCOUNT_KEY=""

# CRON_SECRET — opcional. Se definido, o endpoint /api/cron/alerts exige a chave,
# aceita por header `Authorization: Bearer <CRON_SECRET>` OU query `?secret=<CRON_SECRET>`.
# ATENÇÃO: a Vercel não envia headers em crons — se usar, coloque o segredo na URL
# em vercel.json: "path": "/api/cron/alerts?secret=SEU_SEGREDO".
# Para simplicidade, é seguro deixar vazio (o endpoint é idempotente e exige
# FIREBASE_SERVICE_ACCOUNT_KEY para funcionar).
# CRON_SECRET=""

# INTEGRAÇÃO COM TRELLO — TICKETS DE SUPORTE (aba "Suporte")
# Cada ticket aberto no app cria um card na lista configurada abaixo.
# O Trello também é usado como fonte da listagem "Meus chamados" quando a
# FIREBASE_SERVICE_ACCOUNT_KEY não estiver configurada.
# Como obter as credenciais:
#   1) API Key: acesse https://trello.com/power-ups/admin (ou https://trello.com/app-key)
#      e copie a API Key.
#   2) Token: acesse no navegador (troque SUA_API_KEY) e autorize:
#      https://trello.com/1/authorize?expiration=never&name=AgroStockGPS&scope=read,write&response_type=token&key=SUA_API_KEY
#   3) List ID: com KEY e TOKEN em mãos, descubra os IDs:
#      curl "https://api.trello.com/1/members/me/boards?key=KEY&token=TOKEN"
#      curl "https://api.trello.com/1/boards/BOARD_ID/lists?key=KEY&token=TOKEN"
# Se deixado vazio, a aba Suporte informa que o recurso não está configurado.
TRELLO_API_KEY=""
TRELLO_TOKEN=""
TRELLO_LIST_ID=""
# Opcional. Se ausente, o servidor descobre o quadro automaticamente a partir da lista.
# TRELLO_BOARD_ID=""

# WEBHOOK DO TRELLO — sincronização imediata de comentários, status e etiquetas.
# Deve ser a URL pública HTTPS exata do endpoint abaixo; localhost não é aceito pelo Trello.
# Exemplo: https://seu-dominio.com/api/support/trello/webhook
TRELLO_WEBHOOK_CALLBACK_URL=""
# Segredo da aplicação Trello usado para validar a assinatura X-Trello-Webhook.
# Ele fica na mesma página da API Key e nunca deve ser exposto no frontend.
TRELLO_API_SECRET=""
# Depois de publicar e configurar as variáveis, execute uma única vez:
# npm run trello:webhook:register
